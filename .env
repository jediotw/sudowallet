# ==========================
# HTTP SERVER
# ==========================
PORT=8080

# ==========================
# MYSQL DATABASE
# ==========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sudowallet
DB_USER=sudowallet_user
DB_PASSWORD=sudowallet_password

# ==========================
# DATABASE RETRY
# ==========================
DB_MAX_RETRIES=5
DB_RETRY_DELAY=2s

# ==========================
# CONNECTION POOL
# ==========================
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m

# ==========================
# REDIS DATABASE
# ==========================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================
# JWT
# ==========================
JWT_SECRET=super-secret-jwt-key

# ==========================
# SMTP
# ==========================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@sudowallet.local
# get into mysql
#mysql -u sudowallet_user -p -h 127.0.0.1 -P 3306 sudowallet
#pass:sudowallet_password